generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String       @id @default(uuid())
  email     String       @unique
  password  String
  createdAt DateTime     @default(now())
  results   GameResult[]
}

model GameResult {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  timeSeconds   Float
  correctChars  Int
  wrongAttempts Int
  penaltyTime   Float
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([timeSeconds])
}