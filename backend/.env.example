# PostgreSQL connection string.
# Matches the docker-compose.yml Postgres service by default (port 5433 to
# avoid clashing with any Postgres already running locally on 5432).
DATABASE_URL="postgresql://typing_user:typing_pass@localhost:5433/typing_speed_game"

# Secret used to sign/verify JWTs. Use a long, random string in real
# environments — never commit a real secret to source control.
JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL="http://localhost:5173"

# Port the GraphQL server listens on.
PORT=4000
